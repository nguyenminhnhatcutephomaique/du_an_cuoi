function showError(message) {
errorMessage.textContent = message;
errorMessage.style.display = 'block';
document.querySelector('.container').classList.add('error-container');
setTimeout(() => {
  document.querySelector('.container').classList.remove('error-container');
}, 500);
}

function clearError() {
errorMessage.textContent = '';
errorMessage.style.display = 'none';
}

function capitalizeFirstLetter(str) {
return str.charAt(0).toUpperCase() + str.slice(1);
}

// Simplify location name for search queries
function simplifyLocationName(displayName) {
// Split by commas and take the first significant part (city, town, or district)
const parts = displayName.split(',').map(part => part.trim());
// Prioritize the first part that looks like a city/town/district name
for (const part of parts) {
  if (part && !part.toLowerCase().includes('province') && !part.toLowerCase().includes('vietnam') && !part.match(/ward|district \d+/i)) {
    return part;
  }
}
// Fallback to the first part if no clear match
return parts[0] || displayName;
}

// Search Weather
async function searchWeather() {
const location = locationInput.value.trim();
if (!location) {
  showError('Vui lòng nhập tên xã, huyện, tỉnh!');
  return;
}
if (!apiKey || apiKey === 'YOUR_API_KEY_HERE') {
  showError('Vui lòng nhập API Key hợp lệ trong mã nguồn');
  return;
}
showLoader();
clearError();
try {
  const geoUrl = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(location)}`;
  const geoRes = await fetch(geoUrl);
  if (!geoRes.ok) throw new Error('Lỗi kết nối đến dịch vụ địa điểm');
  const geoData = await geoRes.json();
  if (!geoData.length) throw new Error('Không tìm thấy địa điểm!');

  const lat = geoData[0].lat;
  const lon = geoData[0].lon;
  const displayName = geoData[0].display_name;

  const weatherUrl = `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric&lang=vi`;
  const weatherRes = await fetch(weatherUrl);
  if (!weatherRes.ok) {
    if (weatherRes.status === 401) throw new Error('API Key không hợp lệ');
    throw new Error('Lỗi kết nối đến dịch vụ thời tiết');
  }
  const data = await weatherRes.json();
  hideLoader();
  displayWeatherData(data, displayName);
} catch (error) {
  hideLoader();
  showError(error.message);
}
}

// Display Weather Data
function displayWeatherData(data, displayName) {
if (!data || !data.weather || !data.main) {
  showError('Dữ liệu thời tiết không hợp lệ');
  return;
}

const weatherId = data.weather[0].id;
const weatherMain = data.weather[0].main;
const weatherDescription = data.weather[0].description;
const temp = Math.round(data.main.temp);

locationNameElement.textContent = displayName;
dateTimeElement.textContent = new Date().toLocaleString('vi-VN');
temperatureElement.textContent = `Nhiệt độ: ${temp}°C`;
weatherDescriptionElement.textContent = `Thời tiết: ${weatherDescription}`;
feelsLikeElement.textContent = `Cảm giác như: ${Math.round(data.main.feels_like)}°C`;
humidityElement.textContent = `Độ ẩm: ${data.main.humidity}%`;
windSpeedElement.textContent = `Tốc độ gió: ${Math.round(data.wind.speed * 3.6)} km/h`;

const iconCode = data.weather[0].icon;
weatherIconContainer.innerHTML = `<img src="https://openweathermap.org/img/wn/${iconCode}@2x.png" alt="${weatherDescription}" style="width: 100px;">`;

setWeatherSummary(weatherMain, temp, weatherDescription);
generateWeatherTips(weatherMain, temp, data.main.feels_like, data.wind.speed);
generateActivities(weatherMain, temp);
generateLocationSuggestions(weatherMain, temp, displayName);
updateVisuals(weatherId, weatherMain, temp);

weatherInfo.style.display = 'block';
document.querySelector('.container').classList.add('update');
setTimeout(() => {
  document.querySelector('.container').classList.remove('update');
}, 600);
}

// Set Weather Summary
function setWeatherSummary(weatherMain, temp, weatherDescription) {
let summaryText = '';
switch (weatherMain.toLowerCase()) {
  case 'clear':
    summaryText = temp >= 30 ? `Trời nắng nóng ${temp}°C. Phù hợp cho các hoạt động dưới nước hoặc trong nhà.` :
                 temp >= 20 ? `Trời quang đãng, dễ chịu ${temp}°C. Lý tưởng cho du lịch ngoài trời.` :
                 `Trời quang nhưng mát ${temp}°C. Thích hợp cho đi dạo hoặc khám phá nhẹ nhàng.`;
    break;
  case 'clouds':
    summaryText = `Trời nhiều mây ${temp}°C. Phù hợp cho các hoạt động ngoài trời nhẹ hoặc tham quan văn hóa.`;
    break;
  case 'rain':
  case 'drizzle':
    summaryText = `Trời mưa ${temp}°C. Nên chọn các điểm đến trong nhà như bảo tàng, nhà hàng.`;
    break;
  case 'thunderstorm':
    summaryText = `Trời bão ${temp}°C. Hãy ở trong nhà để đảm bảo an toàn, chọn các địa điểm giải trí trong nhà.`;
    break;
  case 'snow':
    summaryText = `Trời tuyết ${temp}°C. Phù hợp cho các hoạt động mùa đông hoặc thư giãn trong không gian ấm cúng.`;
    break;
  default:
    summaryText = `Thời tiết ${weatherDescription} ${temp}°C. Kiểm tra gợi ý để chọn điểm đến phù hợp.`;
}
weatherSummaryElement.textContent = summaryText;
}

