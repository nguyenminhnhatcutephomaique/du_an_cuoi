// Combine specific and generic locations
const cityKey = Object.keys(touristAttractions).find(key => displayName.toLowerCase().includes(key));
if (cityKey) {
  locations.push(...touristAttractions[cityKey]);
}
locations.push(...genericLocations);

// Limit to 6 locations
locations.slice(0, 6).forEach(location => {
  const item = document.createElement('div');
  item.className = 'location-item';
  item.innerHTML = `
    <div class="location-icon"><i class="fas ${location.icon}"></i></div>
    <div class="location-name">${location.name}</div>
    <div class="location-desc">${location.desc}</div>
  `;
  item.setAttribute('data-location', JSON.stringify(location));
  item.addEventListener('click', () => showLocationDetails(location));
  locationListElement.appendChild(item);
});
}

// Show Location Details in Modal
function showLocationDetails(location) {
const { icon, name, type, details } = location;

modalLocationIcon.innerHTML = `<i class="fas ${icon}"></i>`;
modalLocationName.textContent = name;
modalLocationType.textContent = type || 'Địa điểm';
modalAddress.innerHTML = `<i class="fas fa-map-marker-alt"></i><span>${details.address || 'Không có thông tin'}</span>`;
modalHours.innerHTML = `<i class="fas fa-clock"></i><span>${details.hours || 'Không có thông tin'}</span>`;
modalContact.innerHTML = `<i class="fas fa-phone"></i><span>${details.contact || 'Không có thông tin'}</span>`;
modalDescription.textContent = details.description || 'Không có mô tả chi tiết.';
modalFeatures.innerHTML = details.features?.map(f => `<div class="detail-item"><i class="fas fa-star"></i><span>${f}</span></div>`).join('') || '<div class="detail-item"><i class="fas fa-info-circle"></i><span>Không có thông tin</span></div>';
modalWeatherTip.textContent = details.weatherTip || 'Phù hợp với thời tiết hiện tại.';
modalWebsiteBtn.onclick = () => window.open(details.websiteUrl || details.mapUrl || `https://www.google.com/search?q=${encodeURIComponent(name)}`, '_blank');
modalDirectionsBtn.onclick = () => window.open(details.mapUrl || `https://www.google.com/maps/search/${encodeURIComponent(name)}`, '_blank');

locationModal.style.display = 'flex';
}

// Update Visuals
function updateVisuals(weatherId, weatherMain, temp) {
const body = document.body;
const container = document.querySelector('.container');
body.classList.remove('clear-sky-bg', 'sunny-hot-bg', 'sunny-cool-bg', 'light-clouds-bg', 'dark-clouds-bg', 'light-rain-bg', 'rain-bg', 'heavy-rain-bg', 'thunderstorm-bg', 'snow-bg', 'mist-fog-bg');
container.classList.remove('light-text', 'dark-text');
document.querySelectorAll('.snowflake').forEach(s => s.remove());

if (weatherId >= 600 && weatherId < 700) {
  body.classList.add('snow-bg');
  container.classList.add('dark-text');
  sun.style.display = 'none';
  // Add snowflakes
  for (let i = 0; i < 50; i++) {
    const snowflake = document.createElement('div');
    snowflake.className = 'snowflake';
    snowflake.innerHTML = '❄';
    snowflake.style.left = `${Math.random() * 100}vw`;
    snowflake.style.animationDuration = `${Math.random() * 5 + 5}s`;
    snowflake.style.opacity = Math.random();
    snowflake.style.fontSize = `${Math.random() * 10 + 10}px`;
    body.appendChild(snowflake);
  }
} else if (weatherId >= 800 && weatherId < 801) {
  sun.style.display = 'block';
  if (temp >= 30) {
    body.classList.add('sunny-hot-bg');
    container.classList.add('dark-text');
  } else if (temp >= 15) {
    body.classList.add('clear-sky-bg');
    container.classList.add('light-text');
  } else {
    body.classList.add('sunny-cool-bg');
    container.classList.add('dark-text');
  }
} else if (weatherId >= 801 && weatherId <= 804) {
  body.classList.add(weatherId < 803 ? 'light-clouds-bg' : 'dark-clouds-bg');
  container.classList.add('dark-text');
  sun.style.display = 'none';
} else if (weatherId >= 500 && weatherId < 600) {
  body.classList.add(weatherId < 502 ? 'light-rain-bg' : weatherId < 504 ? 'rain-bg' : 'heavy-rain-bg');
  container.classList.add('dark-text');
  sun.style.display = 'none';
} else if (weatherId >= 200 && weatherId < 300) {
  body.classList.add('thunderstorm-bg');
  container.classList.add('dark-text');
  sun.style.display = 'none';
} else if (weatherId >= 300 && weatherId < 400) {
  body.classList.add('light-rain-bg');
  container.classList.add('dark-text');
  sun.style.display = 'none';
} else if (weatherId >= 700 && weatherId < 800) {
  body.classList.add('mist-fog-bg');
  container.classList.add('dark-text');
  sun.style.display = 'none';
} else {
  body.classList.add('clear-sky-bg');
  container.classList.add('light-text');
  sun.style.display = 'block';
}
}
